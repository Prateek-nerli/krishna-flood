    assert "PULICHINTALA" in contrib_ids, "Upstream Pulichintala tributary missing from Prakasam attention"
    print("  [PASS] Prakasam Barrage XAI correctly routes from Pulichintala and self-loop.")

    print("\n" + "=" * 80)
