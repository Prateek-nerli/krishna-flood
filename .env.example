# Local PostgreSQL (swap this with your NeonDB URL for production)
DATABASE_URL=postgresql://postgres:password@localhost:5432/krishnaflow

# Auth & Seeded Admin Credentials
JWT_SECRET_KEY=change_this_to_a_secure_random_string_in_production
ADMIN_NAME=KrishnaAdmin
ADMIN_EMAIL=admin@krishnaflow.in
ADMIN_PHONE=+919876543210
ADMIN_PASSWORD=Admin@123

# Gmail SMTP (Google Account -> Security -> 2FA -> App Passwords)
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16_char_app_password

# Android SMS Gateway (capcom6/android-sms-gateway Local Server mode)
SMS_GATEWAY_URL=http://192.168.1.100:8080/messages
SMS_GATEWAY_USER=gateway_username
SMS_GATEWAY_PASS=gateway_password
MAX_DAILY_SMS=90
